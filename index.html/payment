<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Join The Class — Choose Your Plan</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Bricolage+Grotesque:wght@300;400;500;600;700;800&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet"/>
<script src="https://js.paystack.co/v1/inline.js"></script>
<style>
:root{
  --bg:#0a0a0a;
  --red:#e8272b;
  --red2:#ff3a3e;
  --gold:#f5c842;
  --green:#00c853;
  --white:#f5f5f0;
  --muted:#7a7a7a;
  --card:#111111;
  --border:rgba(255,255,255,0.08);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--white);font-family:'Bricolage Grotesque',sans-serif;min-height:100vh;overflow-x:hidden;}

/* noise texture */
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:0;opacity:.4;}

.wrap{max-width:860px;margin:0 auto;padding:60px 20px 80px;position:relative;z-index:1;}

/* header */
.top-label{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);text-align:center;margin-bottom:16px;}
h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(42px,8vw,72px);text-align:center;line-height:.95;letter-spacing:.02em;margin-bottom:12px;}
h1 span{color:var(--red);}
.sub{text-align:center;font-size:15px;color:rgba(245,245,240,0.5);max-width:420px;margin:0 auto 48px;}

/* plans grid */
.plans{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
@media(max-width:620px){.plans{grid-template-columns:1fr;}}

.plan{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:32px 28px;position:relative;transition:border-color .3s,transform .3s;}
.plan:hover{border-color:rgba(255,255,255,0.18);transform:translateY(-4px);}

.plan.featured{border-color:var(--gold);background:linear-gradient(145deg,#151500,#111100);}
.plan.featured::before{content:'BEST VALUE';position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--gold);color:#000;font-family:'DM Mono',monospace;font-size:9px;font-weight:700;letter-spacing:.15em;padding:4px 14px;border-radius:20px;}

.plan-name{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;}
.plan-price{font-family:'Bebas Neue',sans-serif;font-size:clamp(48px,7vw,64px);line-height:1;margin-bottom:4px;}
.plan-price sub{font-size:22px;font-family:'Bricolage Grotesque',sans-serif;font-weight:500;vertical-align:baseline;margin-right:2px;}
.plan.featured .plan-price{color:var(--gold);}

.plan-divider{height:1px;background:var(--border);margin:20px 0;}

.features{list-style:none;display:flex;flex-direction:column;gap:11px;margin-bottom:28px;}
.features li{font-size:14px;color:rgba(245,245,240,0.75);display:flex;align-items:flex-start;gap:10px;line-height:1.4;}
.features li::before{content:'✓';color:var(--green);font-weight:700;font-size:13px;flex-shrink:0;margin-top:1px;}
.features li.highlight{color:var(--white);font-weight:600;}
.features li.highlight::before{color:var(--gold);}

.pay-btn{width:100%;padding:16px;border:none;border-radius:10px;font-family:'Bricolage Grotesque',sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:all .25s;letter-spacing:.03em;}
.pay-btn.standard{background:rgba(255,255,255,0.07);color:var(--white);border:1px solid rgba(255,255,255,0.12);}
.pay-btn.standard:hover{background:rgba(255,255,255,0.12);}
.pay-btn.gold{background:var(--gold);color:#000;}
.pay-btn.gold:hover{background:#ffd700;box-shadow:0 8px 32px rgba(245,200,66,.35);}
.pay-btn:disabled{opacity:.6;cursor:not-allowed;}

/* bottom note */
.bottom-note{text-align:center;margin-top:32px;font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);letter-spacing:.08em;}
.bottom-note a{color:var(--muted);text-decoration:underline;}

/* ── EMAIL MODAL ── */
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:200;align-items:center;justify-content:center;padding:20px;}
.modal.open{display:flex;}
.modal-box{background:#111;border:1px solid var(--border);border-radius:16px;padding:36px 28px;max-width:420px;width:100%;text-align:center;}
.modal-box h3{font-family:'Bebas Neue',sans-serif;font-size:34px;margin-bottom:6px;letter-spacing:.03em;}
.modal-box p{font-size:14px;color:rgba(245,245,240,0.55);margin-bottom:24px;line-height:1.6;}

.input-group{position:relative;margin-bottom:10px;}
.input-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:15px;pointer-events:none;}
.modal-input{
  width:100%;
  background:rgba(255,255,255,0.05);
  border:1px solid var(--border);
  border-radius:10px;
  padding:14px 16px 14px 42px;
  color:var(--white);
  font-size:15px;
  font-family:'Bricolage Grotesque',sans-serif;
  outline:none;
  transition:border-color .2s;
}
.modal-input:focus{border-color:rgba(255,255,255,0.3);}
.modal-input::placeholder{color:var(--muted);}
.modal-input.error{border-color:var(--red);}

.error-msg{font-size:12px;color:var(--red);margin-bottom:12px;min-height:16px;font-family:'DM Mono',monospace;}

.modal-confirm{
  width:100%;padding:15px;border:none;border-radius:10px;
  font-size:15px;font-weight:700;cursor:pointer;
  font-family:'Bricolage Grotesque',sans-serif;
  margin-top:4px;transition:all .25s;
}
.modal-confirm.standard{background:rgba(255,255,255,0.1);color:var(--white);border:1px solid rgba(255,255,255,0.15);}
.modal-confirm.standard:hover{background:rgba(255,255,255,0.16);}
.modal-confirm.gold{background:var(--gold);color:#000;}
.modal-confirm.gold:hover{background:#ffd700;box-shadow:0 8px 32px rgba(245,200,66,.35);}
.modal-confirm:disabled{opacity:.6;cursor:not-allowed;}

.modal-cancel{background:none;border:none;color:var(--muted);font-size:13px;cursor:pointer;margin-top:14px;display:block;width:100%;transition:color .2s;}
.modal-cancel:hover{color:var(--white);}

.plan-badge{display:inline-block;margin-bottom:20px;padding:5px 16px;border-radius:20px;font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.15em;text-transform:uppercase;}
.plan-badge.standard{background:rgba(255,255,255,0.08);color:var(--white);}
.plan-badge.gold{background:rgba(245,200,66,0.15);color:var(--gold);border:1px solid rgba(245,200,66,0.3);}

/* animations */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.wrap{animation:fadeUp .6s ease both;}
@keyframes modalIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:scale(1)}}
.modal.open .modal-box{animation:modalIn .25s ease both;}

/* Enrollment notification */
.enroll-toast{
  position:fixed;top:-80px;left:50%;transform:translateX(-50%);
  background:#111;border:1px solid rgba(0,200,83,0.4);border-radius:12px;
  padding:12px 20px;display:flex;align-items:center;gap:12px;
  box-shadow:0 8px 32px rgba(0,0,0,.6);z-index:9999;
  transition:top .5s cubic-bezier(.34,1.56,.64,1);
  min-width:260px;max-width:340px;white-space:nowrap;
}
.enroll-toast.show{top:20px;}
.enroll-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--red),var(--gold));display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.enroll-text{display:flex;flex-direction:column;gap:2px;}
.enroll-name{font-size:13px;font-weight:700;color:var(--white);}
.enroll-sub{font-size:11px;color:var(--green);font-family:'DM Mono',monospace;letter-spacing:.05em;}
.enroll-dot{width:7px;height:7px;border-radius:50%;background:var(--green);flex-shrink:0;box-shadow:0 0 6px var(--green);animation:pulse-dot 1.5s infinite;}
@keyframes pulse-dot{0%,100%{opacity:1}50%{opacity:.3}}
</style>
</head>
<body>

<div class="wrap">
  <div class="top-label">🔴 Limited Slots Available</div>
  <h1>Choose Your <span>Plan</span></h1>
  <p class="sub">One payment. Lifetime access to the class + resources. Pick what works for you.</p>

  <div class="plans">

    <!-- Plan 1: Standard -->
    <div class="plan">
      <div class="plan-name">Standard Access</div>
      <div class="plan-price"><sub>₦</sub>15,900</div>
      <div class="plan-divider"></div>
      <ul class="features">
        <li>Full class access</li>
        <li>AI web design workflow (start to finish)</li>
        <li>How to pitch & land foreign clients</li>
        <li>Class recording & resources</li>
        <li>WhatsApp support group</li>
      </ul>
      <button class="pay-btn standard" onclick="openEmailModal(15900,'Standard Access','standard')">Pay ₦15,900 →</button>
    </div>

    <!-- Plan 2: VIP -->
    <div class="plan featured">
      <div class="plan-name">VIP Access</div>
      <div class="plan-price"><sub>₦</sub>20,000</div>
      <div class="plan-divider"></div>
      <ul class="features">
        <li>Full class access</li>
        <li>AI web design workflow (start to finish)</li>
        <li>How to pitch & land foreign clients</li>
        <li>Class recording & resources</li>
        <li>WhatsApp support group</li>
        <li class="highlight">🎯 1-on-1 Live Session (15 mins) — Joshua reviews your work, answers your questions directly</li>
      </ul>
      <button class="pay-btn gold" onclick="openEmailModal(20000,'VIP Access','gold')">Pay ₦20,000 →</button>
    </div>

  </div>

  <p class="bottom-note">Powered by Paystack · Secure payment · <a href="index.html">← Back to main page</a></p>
</div>

<!-- Email Modal -->
<div class="modal" id="email-modal">
  <div class="modal-box">
    <div class="plan-badge" id="modal-badge"></div>
    <h3>Enter Your Email</h3>
    <p>Your email will be used to send your payment receipt and class details. Use an active email you check.</p>

    <div class="input-group">
      <span class="input-icon">✉️</span>
      <input
        type="email"
        id="customer-email"
        class="modal-input"
        placeholder="e.g. yourname@gmail.com"
        autocomplete="email"
        inputmode="email"
      />
    </div>
    <div class="error-msg" id="email-error"></div>

    <button class="modal-confirm" id="modal-confirm-btn" onclick="confirmPayment()">Proceed to Payment →</button>
    <button class="modal-cancel" onclick="closeEmailModal()">← Go back</button>
  </div>
</div>

<!-- Enrollment Toast -->
<div id="enroll-toast" class="enroll-toast">
  <div class="enroll-avatar">🎓</div>
  <div class="enroll-text">
    <div class="enroll-name" id="toast-name"></div>
    <div class="enroll-sub" id="toast-plan"></div>
  </div>
  <div class="enroll-dot"></div>
</div>

<script>
  // ── State ──
  var _amount = 0;
  var _plan = '';
  var _btnStyle = 'standard';

  // ── Open modal ──
  function openEmailModal(amount, plan, btnStyle) {
    _amount = amount;
    _plan = plan;
    _btnStyle = btnStyle;

    // Update badge
    var badge = document.getElementById('modal-badge');
    badge.textContent = plan;
    badge.className = 'plan-badge ' + btnStyle;

    // Update confirm button style
    var confirmBtn = document.getElementById('modal-confirm-btn');
    confirmBtn.className = 'modal-confirm ' + btnStyle;

    // Clear previous state
    document.getElementById('customer-email').value = '';
    document.getElementById('customer-email').classList.remove('error');
    document.getElementById('email-error').textContent = '';

    document.getElementById('email-modal').classList.add('open');

    // Auto-focus email field
    setTimeout(function(){ document.getElementById('customer-email').focus(); }, 100);
  }

  // ── Close modal ──
  function closeEmailModal() {
    document.getElementById('email-modal').classList.remove('open');
  }

  // Close on backdrop click
  document.getElementById('email-modal').addEventListener('click', function(e){
    if(e.target === this) closeEmailModal();
  });

  // Allow Enter key to confirm
  document.getElementById('customer-email').addEventListener('keydown', function(e){
    if(e.key === 'Enter') confirmPayment();
  });

  // ── Validate & launch Paystack ──
  function confirmPayment() {
    var emailInput = document.getElementById('customer-email');
    var errorEl = document.getElementById('email-error');
    var email = emailInput.value.trim();

    // Basic validation
    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if(!email) {
      emailInput.classList.add('error');
      errorEl.textContent = 'Please enter your email address.';
      emailInput.focus();
      return;
    }
    if(!emailRegex.test(email)) {
      emailInput.classList.add('error');
      errorEl.textContent = 'That doesn\'t look like a valid email. Please check and try again.';
      emailInput.focus();
      return;
    }

    // Clear error
    emailInput.classList.remove('error');
    errorEl.textContent = '';

    // Close modal
    closeEmailModal();

    // Launch Paystack with customer's email
    var handler = PaystackPop.setup({
      key: 'pk_live_8b64abb398ed25d92dda79623c81ba6f40f6ef2d',
      email: email,
      amount: _amount * 100,
      currency: 'NGN',
      ref: 'AICLASS-' + Date.now(),
      metadata: {
        custom_fields: [
          { display_name: 'Plan', variable_name: 'plan', value: _plan },
          { display_name: 'Customer Email', variable_name: 'customer_email', value: email }
        ]
      },
      callback: function(response){
        var msg = encodeURIComponent(
          "Hi Joshua! 👋 I just paid for the *" + _plan + "* of the AI Web Design Class. My reference is " + response.reference + ". Please confirm my enrollment. 🙏"
        );
        window.location.href = 'success.html?plan=' + encodeURIComponent(_plan) + '&ref=' + response.reference;
      },
      onClose: function(){}
    });
    handler.openIframe();
  }

  // ── Enrollment Toast ──
  var names = [
    'Chukwuemeka O.','Taiwo A.','Adaobi N.','Bolarinwa S.','Ifeanyi C.',
    'Ngozi E.','Seun T.','Chidera U.','Oluwaseyi F.','Amaka B.',
    'Tobi D.','Emeka O.','Funmilayo A.','Damilola S.','Uchenna I.',
    'Tolu M.','Akinwale J.','Precious C.','Obinna K.','Sade L.',
    'Yusuf A.','Blessing O.','Kayode T.','Chinwe N.','Femi B.',
    'Rotimi A.','Kelechi N.','Ifeoma C.','Babatunde O.','Rashidat K.',
    'Nnamdi E.','Omotola S.','Gbenga F.','Uche A.','Hadiza M.',
    'Chidi O.','Folake B.','Musa I.','Adunola T.','Ekene C.',
    'Wale O.','Yetunde A.','Biodun F.','Chiamaka N.','Lanre S.'
  ];
  var toastPlans = ['Standard Access','Standard Access','VIP Access','Standard Access','VIP Access'];

  function showToast(){
    var toast = document.getElementById('enroll-toast');
    var name = names[Math.floor(Math.random()*names.length)];
    var plan = toastPlans[Math.floor(Math.random()*toastPlans.length)];
    document.getElementById('toast-name').textContent = name + ' just enrolled';
    document.getElementById('toast-plan').textContent = '✓ ' + plan + ' · just now';
    toast.classList.add('show');
    setTimeout(function(){ toast.classList.remove('show'); }, 4000);
  }

  window.addEventListener('load', function(){
    setTimeout(function loop(){
      showToast();
      setTimeout(loop, (Math.floor(Math.random()*20)+15)*1000);
    }, 3000);
  });
</script>

</body>
</html>
